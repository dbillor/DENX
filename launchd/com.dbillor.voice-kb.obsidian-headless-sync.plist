<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dbillor.voice-kb.obsidian-headless-sync</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>/Users/dbillorgmail.com/Documents/personal operating system/scripts/obsidian-sync-continuous.sh</string>
