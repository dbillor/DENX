OPENAI_REASONING_EFFORT=xhigh
PORT=8787
VAULT_ROOT=./vault
CAPTURE_API_TOKEN=change-me
CAPTURE_MAX_UPLOAD_MB=25
TIMEZONE=America/Los_Angeles
OPENCLAW_NOTIFY_CHANNEL=imessage
